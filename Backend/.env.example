# BAS Software Environment Configuration Example
PORT=8000
NODE_ENV=development

# Database Configuration (Database Name: BAS-SOFTWARE)
MONGO_URI=mongodb://127.0.0.1:27017/BAS-SOFTWARE

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
BIOMETRIC_SECRET=your_biometric_secret_key_here

# Initial Admin Credentials
ADMIN_EMAIL=admin
ADMIN_PASSWORD=your_password_here

# CORS Configuration
CORS_ORIGIN=http://localhost:5001,http://127.0.0.1:5001,http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000,*

# System Timezone
AI_TIMEZONE=Asia/Karachi
