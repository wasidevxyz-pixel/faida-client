# =============================================================================
# Root .gitignore - Bilal Accounting System (BAS Monorepo)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Dependency Directories (Ignored across all projects)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
package-lock.json.backup
*.bin

# -----------------------------------------------------------------------------
# 2. General Logs, Debug Dumps & Error Logs (Desktop, Web, Mobile, Scripts)
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
logs/**
**/logs/
**/logs/**

# Build, Publish, Error & Debug text files generated during compile or test
*build_error*.txt
*build_log*.txt
*publish_error*.txt
*publish_log*.txt
*import_errors*.txt
*_output.txt
debug_output.txt
output.txt
git_diff*.txt
scratch_*.py
**/scratch_*.py
model_diagnostic_result.txt
args_debug.txt
test_user_face.png
local_face_db.json
**/local_face_db.json

# -----------------------------------------------------------------------------
# 3. Environment & Secret Configuration Files
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!Backend/.env.example
!ai-brain/.env.example
!mobile-app/.env.example
Backend/wasi.txt
appsettings.json
**/appsettings.json
!appsettings.json.example
!**/appsettings.json.example
env/
.venv/
venv/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# 4. OS & IDE Metadata
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# -----------------------------------------------------------------------------
# 5. Codebase 1: Main BAS (Node.js / Express / Frontend) Build Outputs
# -----------------------------------------------------------------------------
dist/
build/
out/
.next/
Frontend/build/
Frontend/dist/
.cache/
.sass-cache/
.agent/
coverage/
.nyc_output/

# Duplicate root public folder (canonical one is Frontend/public/)
/public/

# -----------------------------------------------------------------------------
# 6. Codebase 2 & 3: .NET Windows Desktop Apps (Barcode & Biometric Apps)
# -----------------------------------------------------------------------------
# MSBuild / Roslyn / dotnet build outputs
**/[Bb]in/
**/[Oo]bj/
**/publish_out/
**/publish_output/
**/publish_out*/
**/publish_output*/
**/portable-app*/
**/Biometric-App-V*/
**/Barcode-App-V*/
**/v1-app/
*.user
*.userosscache
*.sln.docstates
*.suo
.vs/
**/[Dd]ebug/
**/[Rr]elease/
**/x64/
**/x86/
**/[Aa]pp[Hh]ost.exe

# Executables & Debug Symbols (Native redistributables and build binaries)
*.exe
*.pdb
*.ilk
*.aps
*.intermediate.*
*.tlog

# DLLs - ignore globally EXCEPT vendor SDKs in biometric-app/Lib/
*.dll
!biometric-app/Lib/*.dll
!biometric-app/Lib/**/*.dll

# Archives & Installers
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.iso
*.msi
*.msm
*.msp

# -----------------------------------------------------------------------------
# 7. Codebase 4: Mobile App (React Native / Expo)
# -----------------------------------------------------------------------------
mobile-app/.expo/
**/.expo/
mobile-app/dist/
mobile-app/web-build/
mobile-app/expo-env.d.ts
mobile-app/.kotlin/
**/.metro-health-check*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.pem
*.apk
*.aab
*.ipa
mobile-app/ios/
# mobile-app/android/ (source code tracked for gradlew build; build artifacts ignored below)
mobile-app/android/.gradle/
mobile-app/android/build/
mobile-app/android/app/build/
mobile-app/android/local.properties
mobile-app/android/.cxx/
mobile-app/android/.kotlin/
mobile-app/.eas/

# -----------------------------------------------------------------------------
# 8. Codebase 5: AI Brain (Python / FastAPI)
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# -----------------------------------------------------------------------------
# 9. Backups, Dumps & Temp Files
# -----------------------------------------------------------------------------
EXPORT/
EXPORT
./EXPORT
backup/
backup*/
**/backup/
**/backup/**
**/backup*/
**/backup*/**
backup-*/
backup-*
*.bson
*.metadata.json
screen-shots/
screenshots/
*.bak
*.tmp
temp/
temp*/
temp_docs/
tmp/
tmp*/
MongoDB_PRODUCTION_BACKUP*/
SAFE_MONGODB_BSON_BACKUP*/
mongo_repair_test/
Backend/uploads/download-center/*.pdf
!Backend/uploads/download-center/.gitkeep
Frontend/public/uploads/*
!Frontend/public/uploads/.gitkeep

# -----------------------------------------------------------------------------
# 10. Nested Workspaces & Worktrees
# -----------------------------------------------------------------------------
BAS-SOFTWARE/
BAS-SOFTWARE.worktrees/