# FIDA Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Configuration (Database Name: FAIDA-CLIENT)
MONGO_URI=mongodb://127.0.0.1:27017/FAIDA-CLIENT

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
BIOMETRIC_SECRET=your_biometric_secret_key_here

# Initial Admin Credentials
ADMIN_EMAIL=your_admin_username
ADMIN_PASSWORD=your_password_here

# CORS Configuration
CORS_ORIGIN=*

# System Timezone
AI_TIMEZONE=Asia/Karachi

# AI Provider Keys & Models
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
SAMBANOVA_API_KEY=your_sambanova_api_key
SAMBANOVA_MODEL=Meta-Llama-3.1-8B-Instruct
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
AI_ROUTER_MODEL=llama-3.1-8b-instant
AI_FALLBACK_PROVIDERS=sambanova,openrouter
AI_FALLBACK_MODELS=Meta-Llama-3.1-8B-Instruct,mistralai/mistral-7b-instruct:free
AI_FALLBACK_COOLDOWN_MS=15000
AI_TIMEOUT_MS=20000
AI_RETRIES=1
